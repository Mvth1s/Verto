{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verto",
  "version": "1.9.0",
  "identifier": "app.verto",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Verto",
        "width": 1024,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxQkUxNzZFRUQ0OUUzOUQKUldTZDQwbnRiaGUrUVdZTUdjcG9qQ2xYSFZQUEVHMmlMOUhrdUtPUlF5cDc2ZDhDSmxORnp5cFcK",
      "endpoints": [
        "https://github.com/Mvth1s/Verto/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/pandoc",
      "binaries/ffmpeg"
    ]
  }
}
